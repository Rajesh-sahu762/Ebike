<%@ Master Language="C#" AutoEventWireup="true" CodeFile="AdminMaster.master.cs" Inherits="Admin_AdminMaster" %>

<!DOCTYPE html>
<html lang="en">
<head id="Head1" runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#061522" />
    <title>Admin Control Center | EBikes Duniya</title>

    <!-- Shared EBikes Duniya favicon assets -->
    <link rel="icon" type="image/png" sizes="32x32" href="<%= ResolveUrl("~/Uploads/favicon/favicon-32x32.png") %>" />
    <link rel="icon" type="image/png" sizes="16x16" href="<%= ResolveUrl("~/Uploads/favicon/favicon-16x16.png") %>" />
    <link rel="icon" type="image/png" sizes="192x192" href="<%= ResolveUrl("~/Uploads/favicon/android-chrome-192x192.png") %>" />
    <link rel="icon" type="image/png" sizes="512x512" href="<%= ResolveUrl("~/Uploads/favicon/android-chrome-512x512.png") %>" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>
        :root {
            --admin-bg: #061522;
            --admin-bg-soft: #091d2c;
            --admin-glass: rgba(11, 34, 49, .78);
            --admin-glass-strong: rgba(13, 42, 59, .92);
            --admin-cyan: #22d3ee;
            --admin-cyan-light: #a5f3fc;
            --admin-text: #effbff;
            --admin-muted: #91aab8;
            --admin-border: rgba(148, 210, 226, .13);
            --sidebar-width: 268px;
        }

        * { box-sizing: border-box; }

        html, body { min-height: 100%; }

        body {
            margin: 0;
            color: var(--admin-text);
            background:
                radial-gradient(ellipse at 12% 0%, rgba(8,145,178,.15), transparent 32%),
                radial-gradient(ellipse at 100% 90%, rgba(34,211,238,.08), transparent 30%),
                linear-gradient(135deg, #04111d, #082033 54%, #061522);
            background-attachment: fixed;
            font-family: 'DM Sans', sans-serif;
        }

        a { text-decoration: none; }

        .admin-app {
            display: flex;
            gap: 18px;
            min-height: 100vh;
            padding: 18px;
        }

        /* Sidebar */
        .admin-sidebar {
            position: sticky;
            top: 18px;
            display: flex;
            flex: 0 0 var(--sidebar-width);
            flex-direction: column;
            width: var(--sidebar-width);
            height: calc(100vh - 36px);
            min-height: 620px;
            padding: 22px 16px 16px;
            overflow-y: auto;
            border: 1px solid var(--admin-border);
            border-radius: 23px;
            background: linear-gradient(165deg, rgba(13,47,65,.91), rgba(6,25,39,.91));
            box-shadow: 0 22px 65px rgba(0,0,0,.27), inset 0 1px 0 rgba(255,255,255,.055);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            z-index: 1000;
        }

        .admin-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 2px 9px 23px;
            border-bottom: 1px solid var(--admin-border);
        }

        .admin-brand-mark {
            display: grid;
            flex: 0 0 43px;
            place-items: center;
            width: 43px;
            height: 43px;
            border: 1px solid rgba(103,232,249,.42);
            border-radius: 14px;
            color: #05212c;
            background: linear-gradient(145deg, #a5f3fc, #22d3ee 65%, #0891b2);
            box-shadow: 0 7px 24px rgba(34,211,238,.17);
        }

        .admin-brand-name {
            margin: 0;
            color: #f2fbff;
            font: 800 15px/1.2 'Manrope', sans-serif;
            letter-spacing: -.4px;
        }

        .admin-brand-caption {
            display: block;
            margin-top: 5px;
            color: #83a9b8;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.7px;
            text-transform: uppercase;
        }

        .sidebar-section-label {
            margin: 23px 11px 10px;
            color: #648697;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.6px;
            text-transform: uppercase;
        }

        .sidebar-nav { display: flex; flex-direction: column; gap: 4px; }

        .sidebar-link {
            position: relative;
            display: flex;
            align-items: center;
            gap: 13px;
            min-height: 44px;
            padding: 0 12px;
            border: 1px solid transparent;
            border-radius: 12px;
            color: #9bb5c2;
            font-size: 12px;
            font-weight: 600;
            transition: color .2s ease, background .2s ease, border-color .2s ease, transform .2s ease;
        }

        .sidebar-link i {
            display: grid;
            place-items: center;
            width: 20px;
            color: #79a9ba;
            font-size: 16px;
            transition: color .2s ease;
        }

        .sidebar-link:hover {
            color: #e8fbff;
            border-color: rgba(103,232,249,.10);
            background: rgba(34,211,238,.075);
            transform: translateX(2px);
        }

        .sidebar-link:hover i { color: var(--admin-cyan-light); }

        .sidebar-link.active {
            color: #eaffff;
            border-color: rgba(103,232,249,.20);
            background: linear-gradient(100deg, rgba(8,145,178,.27), rgba(34,211,238,.08));
            box-shadow: inset 3px 0 0 var(--admin-cyan), 0 7px 20px rgba(0,0,0,.12);
        }

        .sidebar-link.active i { color: var(--admin-cyan-light); }

        .sidebar-link .nav-count {
            margin-left: auto;
            padding: 3px 7px;
            border: 1px solid rgba(103,232,249,.16);
            border-radius: 999px;
            color: #a5f3fc;
            background: rgba(34,211,238,.09);
            font-size: 9px;
        }

        .sidebar-spacer { flex: 1; min-height: 20px; }

        .sidebar-security {
            display: flex;
            gap: 10px;
            margin: 16px 2px 13px;
            padding: 13px 11px;
            border: 1px solid rgba(103,232,249,.13);
            border-radius: 13px;
            background: rgba(34,211,238,.045);
        }

        .sidebar-security i { color: var(--admin-cyan); font-size: 17px; }
        .sidebar-security strong { display: block; color: #c7e8ef; font-size: 10px; }
        .sidebar-security span { display: block; margin-top: 3px; color: #789aa9; font-size: 9px; line-height: 1.45; }

        .logout-button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            min-height: 43px;
            border: 1px solid rgba(248,113,113,.20) !important;
            border-radius: 12px !important;
            color: #fca5a5 !important;
            background: rgba(127,29,29,.13) !important;
            font: 700 11px 'DM Sans', sans-serif !important;
            transition: background .2s ease, border-color .2s ease, transform .2s ease;
        }

        .logout-button:hover {
            border-color: rgba(248,113,113,.42) !important;
            background: rgba(127,29,29,.24) !important;
            transform: translateY(-1px);
        }

        /* Main area and topbar */
        .admin-main {
            display: flex;
            flex: 1;
            flex-direction: column;
            min-width: 0;
        }

        .admin-topbar {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            min-height: 88px;
            margin-bottom: 19px;
            padding: 16px 22px;
            border: 1px solid var(--admin-border);
            border-radius: 20px;
            background: linear-gradient(110deg, rgba(13,43,60,.82), rgba(8,29,44,.78));
            box-shadow: 0 15px 42px rgba(0,0,0,.18), inset 0 1px 0 rgba(255,255,255,.055);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
            z-index: 500;
        }

        .topbar-left { display: flex; align-items: center; gap: 14px; min-width: 0; }

        .mobile-menu-btn {
            display: none;
            place-items: center;
            width: 39px;
            height: 39px;
            border: 1px solid var(--admin-border);
            border-radius: 11px;
            color: #b8eaf3;
            background: rgba(34,211,238,.07);
            font-size: 18px;
        }

        .topbar-eyebrow {
            margin-bottom: 5px;
            color: #62cddd;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.7px;
            text-transform: uppercase;
        }

        .topbar-title {
            margin: 0;
            color: #f0fbff;
            font: 800 18px/1.2 'Manrope', sans-serif;
            letter-spacing: -.45px;
        }

        .topbar-subtitle { margin: 5px 0 0; color: #82a1b0; font-size: 10px; }

        .topbar-actions { display: flex; align-items: center; gap: 11px; }

        .topbar-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 36px;
            padding: 0 12px;
            border: 1px solid rgba(103,232,249,.13);
            border-radius: 999px;
            color: #a9c6d1;
            background: rgba(34,211,238,.045);
            font-size: 10px;
            font-weight: 600;
            white-space: nowrap;
        }

        .live-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #34d399;
            box-shadow: 0 0 10px rgba(52,211,153,.7);
        }

        .topbar-divider { width: 1px; height: 35px; background: var(--admin-border); }

        .notification-wrap { position: relative; }

        .icon-action {
            position: relative;
            display: grid;
            place-items: center;
            width: 41px;
            height: 41px;
            border: 1px solid var(--admin-border);
            border-radius: 12px;
            color: #b9d6e0;
            background: rgba(255,255,255,.035);
            cursor: pointer;
            transition: color .2s ease, border-color .2s ease, background .2s ease;
        }

        .icon-action:hover, .icon-action[aria-expanded="true"] {
            color: var(--admin-cyan-light);
            border-color: rgba(103,232,249,.30);
            background: rgba(34,211,238,.09);
        }

        .icon-action > i { font-size: 17px; }

        .notification-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            display: grid;
            place-items: center;
            min-width: 18px;
            height: 18px;
            padding: 0 4px;
            border: 2px solid #0b2638;
            border-radius: 999px;
            color: #06212c;
            background: #67e8f9;
            font-size: 9px;
            font-weight: 800;
        }

        .notification-panel {
            position: absolute;
            top: 52px;
            right: 0;
            display: none;
            width: min(330px, calc(100vw - 35px));
            padding: 15px;
            border: 1px solid rgba(103,232,249,.20);
            border-radius: 16px;
            background: rgba(8,29,44,.97);
            box-shadow: 0 22px 55px rgba(0,0,0,.42);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            z-index: 1200;
        }

        .notification-panel.show { display: block; animation: panel-in .16s ease-out; }
        @keyframes panel-in { from { opacity: 0; transform: translateY(-5px); } to { opacity: 1; transform: translateY(0); } }

        .notification-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--admin-border);
        }

        .notification-head h6 { margin: 0; color: #e8faff; font: 700 12px 'Manrope', sans-serif; }
        .notification-head span { color: #789baa; font-size: 9px; }
        #notifContent { max-height: 260px; overflow: auto; padding-top: 9px; color: #9ebbc7; font-size: 11px; }
        .notif-item { margin: 4px 0; padding: 11px 10px; border: 1px solid transparent; border-radius: 10px; color: #b9d4de; cursor: pointer; font-size: 11px; }
        .notif-item:hover { border-color: rgba(103,232,249,.12); background: rgba(34,211,238,.07); }
        .notification-empty { padding: 17px 8px; color: #789baa; text-align: center; font-size: 11px; }
        .clear-notifications {
            width: 100%;
            margin-top: 10px;
            padding: 8px 10px;
            border: 1px solid rgba(248,113,113,.17);
            border-radius: 9px;
            color: #fca5a5;
            background: rgba(127,29,29,.12);
            font-size: 10px;
            font-weight: 700;
        }
        .clear-notifications:hover { background: rgba(127,29,29,.23); }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 10px;
            padding-left: 2px;
        }

        .admin-avatar {
            display: grid;
            place-items: center;
            width: 39px;
            height: 39px;
            border: 1px solid rgba(103,232,249,.28);
            border-radius: 13px;
            color: #06212c;
            background: linear-gradient(145deg, #a5f3fc, #22d3ee);
            font: 800 13px 'Manrope', sans-serif;
            box-shadow: 0 5px 18px rgba(34,211,238,.13);
        }

        .admin-user-name { display: block; max-width: 130px; overflow: hidden; color: #e9f8fc; font-size: 11px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
        .admin-user-role { display: block; margin-top: 3px; color: #789baa; font-size: 9px; }

        .admin-content {
            flex: 1;
            min-width: 0;
            padding: 4px 3px 18px;
        }

        .sidebar-backdrop { display: none; }

        /* Shared content surfaces for existing Admin pages */
        .admin-content .card, .admin-content .card-custom, .admin-content .stat-box {
            border: 1px solid var(--admin-border);
            border-radius: 16px;
            color: var(--admin-text);
            background: var(--admin-glass);
            box-shadow: 0 12px 32px rgba(0,0,0,.15), inset 0 1px 0 rgba(255,255,255,.035);
        }

        .admin-content .form-control, .admin-content .form-select {
            border-color: rgba(145,190,207,.18);
            color: #effbff;
            background-color: rgba(3,17,28,.55);
        }

        .admin-content .form-control:focus, .admin-content .form-select:focus {
            border-color: rgba(34,211,238,.65);
            box-shadow: 0 0 0 3px rgba(34,211,238,.10);
        }

        .admin-content .form-control::placeholder { color: #789baa; }
        .admin-content select option { color: #effbff; background: #0b2638; }

        @media (max-width: 1100px) {
            :root { --sidebar-width: 245px; }
            .topbar-pill { display: none; }
        }

        @media (max-width: 820px) {
            .admin-app { gap: 0; padding: 12px; }
            .admin-sidebar {
                position: fixed;
                top: 12px;
                bottom: 12px;
                left: 12px;
                width: min(285px, calc(100vw - 55px));
                height: auto;
                min-height: 0;
                transform: translateX(calc(-100% - 22px));
                transition: transform .25s ease;
                z-index: 1400;
            }
            .admin-sidebar.open { transform: translateX(0); }
            .sidebar-backdrop {
                position: fixed;
                inset: 0;
                display: block;
                visibility: hidden;
                opacity: 0;
                background: rgba(0,9,16,.62);
                transition: opacity .25s ease, visibility .25s ease;
                z-index: 1300;
            }
            .sidebar-backdrop.show { visibility: visible; opacity: 1; }
            .mobile-menu-btn { display: grid; }
            .admin-topbar { min-height: 78px; padding: 13px 15px; }
            .topbar-title { font-size: 16px; }
            .topbar-subtitle { display: none; }
            .admin-content { padding: 2px 0 15px; }
        }

        @media (max-width: 520px) {
            .admin-app { padding: 9px; }
            .admin-topbar { gap: 9px; margin-bottom: 14px; padding: 11px 12px; border-radius: 16px; }
            .topbar-left { gap: 9px; }
            .mobile-menu-btn { width: 36px; height: 36px; }
            .topbar-eyebrow { font-size: 8px; }
            .topbar-title { font-size: 14px; }
            .topbar-actions { gap: 7px; }
            .topbar-divider { display: none; }
            .icon-action { width: 36px; height: 36px; border-radius: 10px; }
            .admin-avatar { width: 35px; height: 35px; border-radius: 11px; }
            .admin-user-copy { display: none; }
            .notification-panel { right: -48px; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; }
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>

<body>
    <form id="Form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" />

        <div class="admin-app">
            <aside class="admin-sidebar" id="adminSidebar">
                <div class="admin-brand">
                    <div class="admin-brand-mark" aria-hidden="true">
                        <i class="bi bi-lightning-charge-fill fs-4"></i>
                    </div>
                    <div>
                        <p class="admin-brand-name">EBikes Duniya</p>
                        <span class="admin-brand-caption">Admin Control Center</span>
                    </div>
                </div>

                <div class="sidebar-section-label">Overview</div>
                <nav class="sidebar-nav" aria-label="Main navigation">
                    <a class="sidebar-link" href="AdminDashboard.aspx"><i class="bi bi-grid-1x2-fill"></i><span>Dashboard</span></a>
                </nav>

                <div class="sidebar-section-label">Approvals</div>
                <nav class="sidebar-nav" aria-label="Approvals">
                    <a class="sidebar-link" href="ApproveDealers.aspx"><i class="bi bi-person-check-fill"></i><span>Approve Dealers</span></a>
                    <a class="sidebar-link" href="ApproveBikes.aspx"><i class="bi bi-bicycle"></i><span>Approve Bikes</span></a>
                </nav>

                <div class="sidebar-section-label">Marketplace</div>
                <nav class="sidebar-nav" aria-label="Marketplace management">
                    <a class="sidebar-link" href="ManageUsers.aspx"><i class="bi bi-people-fill"></i><span>Manage Users</span></a>
                    <a class="sidebar-link" href="ManageBrands.aspx"><i class="bi bi-tags-fill"></i><span>Manage Brands</span></a>
                    <a class="sidebar-link" href="ManageParts.aspx"><i class="bi bi-gear-wide-connected"></i><span>Manage Parts</span></a>
                    <a class="sidebar-link" href="ManageLeads.aspx"><i class="bi bi-inbox-fill"></i><span>Manage Leads</span></a>
                </nav>

                <div class="sidebar-section-label">Infrastructure</div>
                <nav class="sidebar-nav" aria-label="Infrastructure">
                    <a class="sidebar-link" href="AddChargingStation.aspx"><i class="bi bi-ev-station-fill"></i><span>Add Station</span></a>
                    <a class="sidebar-link" href="ManageChargingStations.aspx"><i class="bi bi-geo-alt-fill"></i><span>Stations Management</span></a>
                </nav>

                <div class="sidebar-section-label">Rentals & Revenue</div>
                <nav class="sidebar-nav" aria-label="Rentals and revenue">
                    <a class="sidebar-link" href="RentalManagement.aspx"><i class="bi bi-calendar2-check-fill"></i><span>Rental Management</span></a>
                    <a class="sidebar-link" href="AdminRentalSettlement.aspx"><i class="bi bi-wallet2"></i><span>Rental Settlement</span></a>
                    <a class="sidebar-link" href="AdminSubscriptionRequests.aspx"><i class="bi bi-receipt-cutoff"></i><span>Subscription Requests</span></a>
                </nav>

                <div class="sidebar-section-label">Insights & System</div>
                <nav class="sidebar-nav" aria-label="Reports and settings">
                    <a class="sidebar-link" href="Reports.aspx"><i class="bi bi-bar-chart-line-fill"></i><span>Reports</span></a>
                    <a class="sidebar-link" href="Settings.aspx"><i class="bi bi-sliders"></i><span>Settings</span></a>
                </nav>

                <div class="sidebar-spacer"></div>

                <div class="sidebar-security">
                    <i class="bi bi-shield-lock-fill"></i>
                    <div><strong>Protected workspace</strong><span>Authorized administrator access only</span></div>
                </div>

                <asp:Button ID="btnLogout" runat="server" Text="Sign out" CssClass="btn logout-button w-100" OnClick="btnLogout_Click" />
            </aside>

            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

            <main class="admin-main">
                <header class="admin-topbar">
                    <div class="topbar-left">
                        <button type="button" class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open navigation" aria-expanded="false">
                            <i class="bi bi-list"></i>
                        </button>
                        <div>
                            <div class="topbar-eyebrow">EBIKES DUNIYA / ADMINISTRATION</div>
                            <h1 class="topbar-title" id="topbarTitle">Control Center</h1>
                            <p class="topbar-subtitle">Monitor your marketplace and manage daily operations.</p>
                        </div>
                    </div>

                    <div class="topbar-actions">
                        <div class="topbar-pill"><span class="live-dot"></span> System operational</div>
                        <div class="topbar-divider"></div>

                        <div class="notification-wrap">
                            <button type="button" class="icon-action" id="bellIcon" aria-label="Notifications" aria-expanded="false">
                                <i class="bi bi-bell"></i>
                                <span class="notification-badge" id="notifBadge">0</span>
                            </button>

                            <div class="notification-panel" id="notifPanel">
                                <div class="notification-head">
                                    <h6><i class="bi bi-bell-fill me-2" style="color:#67e8f9;"></i>Notifications</h6>
                                    <span>Live updates</span>
                                </div>
                                <div id="notifContent"><div class="notification-empty">Loading notifications...</div></div>
                                <button type="button" id="clearNotifBtn" class="clear-notifications"><i class="bi bi-check2-all me-1"></i> Clear notification view</button>
                            </div>
                        </div>

                        <div class="topbar-divider"></div>

                        <div class="admin-user">
                            <div class="admin-avatar" aria-hidden="true" id="adminAvatar">AD</div>
                            <div class="admin-user-copy">
                                <span class="admin-user-name"><%= Server.HtmlEncode(Convert.ToString(Session["AdminName"]) == "" ? "Administrator" : Convert.ToString(Session["AdminName"])) %></span>
                                <span class="admin-user-role">Super Admin</span>
                            </div>
                        </div>
                    </div>
                </header>

                <section class="admin-content">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server"></asp:ContentPlaceHolder>
                </section>
            </main>
        </div>
    </form>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            var sidebar = document.getElementById('adminSidebar');
            var backdrop = document.getElementById('sidebarBackdrop');
            var menuButton = document.getElementById('mobileMenuBtn');
            var bellButton = document.getElementById('bellIcon');
            var notificationPanel = document.getElementById('notifPanel');
            var clearButton = document.getElementById('clearNotifBtn');

            function closeSidebar() {
                if (!sidebar || !backdrop || !menuButton) return;
                sidebar.classList.remove('open');
                backdrop.classList.remove('show');
                menuButton.setAttribute('aria-expanded', 'false');
                document.body.style.overflow = '';
            }

            if (menuButton) {
                menuButton.addEventListener('click', function () {
                    var isOpen = sidebar.classList.toggle('open');
                    backdrop.classList.toggle('show', isOpen);
                    menuButton.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                    document.body.style.overflow = isOpen ? 'hidden' : '';
                });
            }

            if (backdrop) backdrop.addEventListener('click', closeSidebar);

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeSidebar();
                    if (notificationPanel) notificationPanel.classList.remove('show');
                    if (bellButton) bellButton.setAttribute('aria-expanded', 'false');
                }
            });

            // Highlight the current page without changing any navigation destinations.
            var currentPage = window.location.pathname.split('/').pop().toLowerCase();
            var links = document.querySelectorAll('.sidebar-link');
            links.forEach(function (link) {
                var targetPage = link.getAttribute('href').split('/').pop().toLowerCase();
                if (targetPage === currentPage) {
                    link.classList.add('active');
                    var label = link.querySelector('span');
                    var title = document.getElementById('topbarTitle');
                    if (label && title) title.textContent = label.textContent.trim();
                }
            });

            // Use the signed-in administrator's initials in the avatar.
            var nameElement = document.querySelector('.admin-user-name');
            var avatar = document.getElementById('adminAvatar');
            if (nameElement && avatar) {
                var parts = nameElement.textContent.trim().split(/\s+/);
                var initials = parts.length > 1 ? parts[0].charAt(0) + parts[parts.length - 1].charAt(0) : parts[0].substring(0, 2);
                avatar.textContent = initials.toUpperCase();
            }

            if (bellButton && notificationPanel) {
                bellButton.addEventListener('click', function (event) {
                    event.stopPropagation();
                    var isOpen = notificationPanel.classList.toggle('show');
                    bellButton.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                });

                document.addEventListener('click', function (event) {
                    if (!notificationPanel.contains(event.target) && !bellButton.contains(event.target)) {
                        notificationPanel.classList.remove('show');
                        bellButton.setAttribute('aria-expanded', 'false');
                    }
                });
            }

            if (clearButton) {
                clearButton.addEventListener('click', function () {
                    $('#notifContent').html('<div class="notification-empty">No new notifications</div>');
                    $('#notifBadge').text('0');
                });
            }
        })();

        function loadNotifications() {
            $.ajax({
                type: "POST",
                url: "AdminMaster.master/GetNotifications",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    var data = response.d || {};
                    $("#notifBadge").text(data.Total || 0);

                    var html = "";
                    if (data.PendingDealers > 0)
                        html += "<div class='notif-item' onclick=\"window.location='ApproveDealers.aspx'\"><i class='bi bi-person-check-fill me-2' style='color:#67e8f9;'></i>Pending Dealers: " + data.PendingDealers + "</div>";

                    if (data.PendingBikes > 0)
                        html += "<div class='notif-item' onclick=\"window.location='ApproveBikes.aspx'\"><i class='bi bi-bicycle me-2' style='color:#67e8f9;'></i>Pending Bikes: " + data.PendingBikes + "</div>";

                    if (data.UnreadLeads > 0)
                        html += "<div class='notif-item' onclick=\"window.location='ManageLeads.aspx'\"><i class='bi bi-inbox-fill me-2' style='color:#67e8f9;'></i>Unread Leads: " + data.UnreadLeads + "</div>";

                    if (html === "") html = "<div class='notification-empty'>You're all caught up. No new notifications.</div>";
                    $("#notifContent").html(html);
                },
                error: function () {
                    $("#notifContent").html("<div class='notification-empty'>Notifications are temporarily unavailable.</div>");
                }
            });
        }

        $(document).ready(function () {
            loadNotifications();
            window.setInterval(loadNotifications, 5000);
        });
    </script>
</body>
</html>
